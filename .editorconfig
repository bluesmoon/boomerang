# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = false

# 8 space wide tab indentation
[*.js]
indent_style = space
indent_size = 8

# Matches the exact files either package.json or .travis.yml
[{package.json}]
indent_style = space
indent_size = 2
